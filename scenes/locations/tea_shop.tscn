avatar_texture = ExtResource("9_min_avatar")
dialogue_lines = Array[String](["Mingalarbar! Ah, my eyes are heavy from grading examination papers all evening.", "In a Yangon tea shop, you must know your brew! I need something bold and extra strong to fuel my mind through the midnight hours.", "A heavy dose of dark Assam tea leaves with a sweet kick—Cho-pyit (Sweet & Strong) is the only drink that will keep me awake!"])

