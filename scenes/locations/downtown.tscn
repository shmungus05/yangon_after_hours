dialogue_lines = Array[String](["Hold on there, friend! Walking downtown in the rain so late?", "I keep watch over these old colonial banks and heritage halls. Nothing escapes my eyes.", "Though if you're looking for that hurried fellow with the briefcase, he darted toward the tea shops on 38th Street!"])

