[node name="NarrativeLabel" type="Label" parent="CenterContainer/EndingCard/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.9, 0.93, 0.97, 1)
theme_override_font_sizes/font_size = 14
text = "Through the rain-washed streets of downtown Sule, the sweet tea aromas of 38th Street, and the vibrant riverfront stalls of Strand Road, you tracked down every missing thread.

• You untangled the crowded tea orders for Saya Min, Ma Thida, and Ko Aung, obtaining the harbor cargo slip.
• You cracked the combination lock on Ko Lin's iron spice chest at the Night Market, safely recovering his missing grandfather's recipe and delivery ledger.
• Synthesizing the Royal Hintha Seal and Secret Passcode 1886, you verified the midnight delivery with Night Watchman U Ba and secured the stolen colonial brass relics inside the Downtown Heritage Vault.

As the first golden rays of dawn rise over Sule Pagoda, the steam from the tea shop kettles drifts into the cool morning breeze. The historic treasures of Yangon are safe once more."
autowrap_mode = 3

